# Copy this file to `.env` and fill in real values. `.env` is git-ignored.
# NEVER commit real secrets.

# --- Neo4j (docker compose) ---
NEO4J_URI=bolt://localhost:7688
NEO4J_USER=neo4j
NEO4J_PASSWORD=entdecdevpass
NEO4J_DATABASE=neo4j

# --- Ollama (host machine) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_EMBED_MODEL=qwen3-embedding:4b
OLLAMA_GEN_MODEL=qwen3:4b

# --- run profile: tiny | default ---
ENTDEC_PROFILE=tiny

# --- paths (optional overrides; defaults are relative to the project root) ---
# ENTDEC_DATA_DIR=data
# ENTDEC_PROCESSED_DIR=data/processed
# ENTDEC_REPORTS_DIR=reports
# ENTDEC_CACHE_DIR=.cache

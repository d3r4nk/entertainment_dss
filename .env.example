# Copy this file to `.env` and fill in real values. `.env` is git-ignored.
# NEVER commit real secrets.

# --- Neo4j (docker compose) ---
NEO4J_URI=bolt://localhost:7688
NEO4J_USER=neo4j
NEO4J_PASSWORD=replace_with_a_strong_password
NEO4J_DATABASE=neo4j

# --- account and chat-history database ---
MYSQL_ROOT_PASSWORD=replace_with_a_strong_random_password
MYSQL_DATABASE=entdec
MYSQL_USER=entdec
MYSQL_PASSWORD=replace_with_a_strong_random_password
ENTDEC_DB_URL=mysql+pymysql://${MYSQL_USER}:${MYSQL_PASSWORD}@127.0.0.1:3307/${MYSQL_DATABASE}?charset=utf8mb4
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENTDEC_SECRET_KEY=replace_with_a_fernet_key
# Set to 1 only for local development/tests; production defaults to auth enabled.
ENTDEC_AUTH_DISABLED=0

# --- Ollama (host machine) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_EMBED_MODEL=qwen3-embedding:4b
OLLAMA_GEN_MODEL=qwen3:4b

# Optional TMDB API Read Access Token for movie posters
# TMDB_READ_ACCESS_TOKEN=

# --- run profile: tiny | default ---
ENTDEC_PROFILE=tiny
# ENTDEC_MEMORY_ENABLED=true

# --- paths (optional overrides; defaults are relative to the project root) ---
# ENTDEC_DATA_DIR=data
# ENTDEC_PROCESSED_DIR=data/processed
# ENTDEC_REPORTS_DIR=reports
# ENTDEC_CACHE_DIR=.cache
